# Copy to server/.env and client/.env (see README).

# --- server/.env ---
# DATABASE_URL="file:./dev.db"
# PORT=3001
# OPENAI_API_KEY=          # optional — app works without it
# CLIENT_URL=http://localhost:5173
# For production (Render/Railway): set CLIENT_URL to your public URL, e.g. https://wayflow.onrender.com
# SERVE_STATIC=true        # set on host when serving the built React app from Express

# --- client/.env ---
# VITE_GITHUB_REPO_URL=https://github.com/YOUR_USERNAME/wayflow
