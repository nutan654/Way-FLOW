# Set your GitHub repo URL (shown in sidebar, Source page, and file links)
VITE_GITHUB_REPO_URL=https://github.com/your-username/wayflow

# Only needed if the client is deployed separately from the API
# (e.g. client on Vercel, API on Render). Point it at your API's base URL,
# no trailing slash. Leave unset if client + API share the same origin.
VITE_API_URL=https://your-api.onrender.com
